# Copy to .env on the server and fill in. Never commit .env.

# Public address of the shop, without a trailing slash
SITE_URL=https://plana-planer.de
SITE_DOMAIN=plana-planer.de

# false: the site shows the configurator and collects waiting-list signups.
# true: orders and vouchers can be bought.
SHOP_OPEN=false

# Password for /admin (orders, print files). Choose a long one.
ADMIN_PASSWORD=

# Stripe: Dashboard > Developers > API keys (secret key), and the signing secret of the
# webhook endpoint https://plana-planer.de/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true only after Stripe Tax is registered in the dashboard (Settings › Tax)
STRIPE_TAX=false

# Claude API key for the design assistant and the birthday photo scan (console.anthropic.com).
# Without it both are switched off and everything else works.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=400

# Mail: SMTP of your provider, e.g. Brevo: smtps://LOGIN:KEY@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=plana studio <hallo@plana-planer.de>
# Where a note about each new order goes
ORDER_NOTIFY_EMAIL=

# Waiting list: the action URL of your Brevo signup form (double opt-in). Read at build time.
NEXT_PUBLIC_WAITLIST_URL=

# Print partner Posterflow (optional). Without POSTERFLOW_API_KEY the hand-off is off and
# /admin works as before (download the PDF, upload by hand). Key: posterflow.de > Konto > API-Zugang.
# Never use their public test key with real customer data: test orders are visible to others.
POSTERFLOW_API_KEY=
POSTERFLOW_BASE_URL=https://api.posterflow.de/api
# Article and size as Posterflow's API expects them. These defaults are inferred from their
# docs; check them under /admin > "Posterflow-Artikel anzeigen" once the key is set.
POSTERFLOW_ARTICLE_TYPE=white250
POSTERFLOW_SIZE=70x100
# For the landscape layouts (Vier Wochen, Monatszeilen). Ask Posterflow whether this is 70x100 or 100x70.
POSTERFLOW_SIZE_LANDSCAPE=70x100
# DHL, DHLWP or Auto (Auto only after agreeing it with Posterflow)
POSTERFLOW_SHIPPING_COMPANY=DHL
# Shared secret for signed status callbacks, if Posterflow enables signing for us.
# Callback URL to give them: <SITE_URL>/api/posterflow/webhook
POSTERFLOW_WEBHOOK_SECRET=
# Sender and return address on the DHL label
POSTERFLOW_SENDER_COMPANY=plana studio
POSTERFLOW_SENDER_FIRST_NAME=
POSTERFLOW_SENDER_LAST_NAME=
POSTERFLOW_SENDER_STREET=
POSTERFLOW_SENDER_STREET_NUMBER=
POSTERFLOW_SENDER_ZIP=
POSTERFLOW_SENDER_CITY=
POSTERFLOW_SENDER_EMAIL=
POSTERFLOW_SENDER_PHONE=
# Signs the print file links Posterflow downloads. At least 32 random characters,
# e.g. the output of: openssl rand -hex 32
PRINT_FILE_SECRET=
# How many days a print file link stays valid
PRINT_FILE_URL_DAYS=14
